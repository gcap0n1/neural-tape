# Neural Tape — environment template
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# ── LLM provider (DeepSeek or any OpenAI-compatible endpoint) ──────────────
# Used by lex/v22/classifier.py and lex/v3/classifier.py
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Alternative key name (same purpose, fallback if LLM_API_KEY is absent)
# DEEPSEEK_API_KEY=your-key-here

# ── Optional: override default endpoint/model ─────────────────────────────
# NEURAL_TAPE_ENV=/absolute/path/to/custom/.env
